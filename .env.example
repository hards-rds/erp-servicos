# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_URL=http://localhost:3000
APP_ENV=development

# Fiscal / NFS-e
NFSE_ENV=homologation
NFSE_NACIONAL_ENDPOINT=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
NFSE_PRODUCTION_ENABLED=false
NFSE_REAL_EMISSION=false
# Defina antes do primeiro upload. Ao trocar esta chave, recadastre o certificado.
CERTIFICATE_ENCRYPTION_KEY=

# Banco Inter
INTER_ENV=sandbox
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=
INTER_CERT_PASSWORD=
# Use em producao na Vercel para evitar arquivo local: base64 do PFX do Inter.
INTER_PFX_BASE64=
INTER_REAL_CHARGE=false

# E-mail
EMAIL_PROVIDER=resend
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_API_KEY=
