# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_URL=http://localhost:3000
APP_ENV=development

# Fiscal / NFS-e
NFSE_ENV=homologation
NFSE_NACIONAL_ENDPOINT=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
NFSE_PRODUCTION_ENABLED=false
NFSE_REAL_EMISSION=false
# Defina antes do primeiro upload. Ao trocar esta chave, recadastre o certificado.
CERTIFICATE_ENCRYPTION_KEY=

# Banco Inter
# Configurado por tenant no painel em Configuracoes > APIs.
# As credenciais e o PFX usam CERTIFICATE_ENCRYPTION_KEY para criptografia no banco.

# E-mail
EMAIL_PROVIDER=resend
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_API_KEY=
